generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id                      String   @id @default(cuid())
  responsible             String
  projectName             String
  importer                String
  importerPhone           String?
  importerEmail           String?
  country                 String
  startDate               String
  endDate                 String
  kosherBody              String
  supervisor              String
  supervisorPhone         String?
  factoryName             String
  factoryAddress          String
  status                  String
  currentStage            String
  templateId              String?
  // Real relations to master data. The name strings above stay as a snapshot
  // (history + convenient display); these link by id for integrity + joins.
  importerId              String?
  importerRef             Importer?   @relation(fields: [importerId], references: [id], onDelete: SetNull)
  supervisorId            String?
  supervisorRef           Supervisor? @relation(fields: [supervisorId], references: [id], onDelete: SetNull)
  kosherBodyId            String?
  kosherBodyRef           KosherBody? @relation(fields: [kosherBodyId], references: [id], onDelete: SetNull)
  stages                  String   @default("[]")
  enabledTools            String   @default("[]")
  reportReceived          Boolean  @default(false)
  reportPhoto             String?
  sentToChaim             Boolean  @default(false)
  sentToKosherBody        Boolean  @default(false)
  certReceived            Boolean  @default(false)
  submittedToRabbinate    Boolean  @default(false)
  submittedForPayment     Boolean  @default(false)
  paid                    Boolean  @default(false)
  profitDaily             Int
  kosherFee               Int
  submissionFee           Int
  actualExpenses          Int?
  quotedPrice             Int?
  daysDelayed             Int?
  timeline                String
  chatHistory             String
  flight                  String
  hotel                   String
  needsFlightBooking      Boolean  @default(false)
  clientAwaitingResponse  Boolean  @default(false)
  productionDetails       String?
  approvers               String   @default("[]")
  archivedAt              DateTime? // set = archived (hidden from lists, restorable)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([responsible])
  @@index([archivedAt])
  @@index([status])
  @@index([importerId])
  @@index([supervisorId])
  @@index([kosherBodyId])
}

model Template {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  icon        String   @default("FileText")
  color       String   @default("bg-slate-50 border-slate-200 text-slate-700")
  category    String   @default("")
  stages      String   @default("[]") // JSON: TemplateStage[]
  tools       String   @default("[]") // JSON: ToolKey[] (enabled optional tools)
  isDefault   Boolean  @default(false)
  isArchived  Boolean  @default(false)
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isArchived])
}

model Setting {
  key       String   @id
  value     String // JSON
  updatedAt DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  name         String   @unique
  role         String   @default("secretary") // admin | secretary
  avatar       String   @default("")
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Importer {
  id            String    @id @default(cuid())
  name          String    @unique
  contactPerson String?
  phone         String?
  email         String?
  country       String?
  notes         String?
  projects      Project[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model KosherBody {
  id            String   @id @default(cuid())
  name          String   @unique
  contactPerson String?
  phone         String?
  email         String?
  region        String? // where they certify
  notes         String?
  active        Boolean   @default(true)
  projects      Project[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Supervisor {
  id           String   @id @default(cuid())
  name         String   @unique
  phone        String?
  email        String?
  kosherBodies String?
  regions      String? // areas/countries the supervisor is willing to travel to (comma-separated)
  availability String? // free-text schedule / לו״ז (e.g. "פנוי מ-15/8", "לא זמין באוגוסט")
  active       Boolean   @default(true) // currently taking assignments
  notes        String?
  projects     Project[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  projectId   String
  action      String
  fieldName   String?
  oldValue    String?
  newValue    String?
  performedBy String
  timestamp   DateTime @default(now())

  @@index([projectId])
  @@index([timestamp])
}

// Central document index. The bytes live in object storage (Vercel Blob);
// this row holds the searchable metadata + the URL, organized per project.
model Document {
  id            String   @id @default(cuid())
  projectId     String
  requirementId String? // links back to the requirement it fulfills, if any
  fileName      String // organized system name
  originalName  String // as uploaded by the user
  mimeType      String?
  size          Int?
  category      String? // report | certificate | invoice | photo | other
  url           String
  storage       String   @default("blob") // blob | drive | local
  uploadedBy    String?
  createdAt     DateTime @default(now())

  @@index([projectId])
  @@index([fileName])
  @@index([category])
}
