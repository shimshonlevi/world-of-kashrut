# Copy to `.env` (local) and set the same vars in Vercel (Project → Settings → Environment Variables).
# Never commit `.env`.

# --- Database: PostgreSQL (Neon) ---
# Local dev and production both use a Postgres connection string.
# Get a free DB at https://neon.tech → copy the "Pooled" connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Auth ---
# Long random string used to sign login sessions. Generate: openssl rand -hex 32
AUTH_SECRET=

# --- OpenAI (AI assistant) ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- File storage: Vercel Blob ---
# Document bytes are stored in Vercel Blob (metadata + search live in Neon).
# Create a Blob store in Vercel → Storage, then copy its read/write token here.
BLOB_READ_WRITE_TOKEN=
