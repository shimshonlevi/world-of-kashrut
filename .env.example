# Copy to `.env` (local) and set the same vars in Vercel (Project → Settings → Environment Variables).
# Never commit `.env`.

# --- Database: PostgreSQL (Neon) ---
# Local dev and production both use a Postgres connection string.
# Get a free DB at https://neon.tech → copy the "Pooled" connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Auth ---
# Long random string used to sign login sessions. Generate: openssl rand -hex 32
AUTH_SECRET=

# --- OpenAI (AI assistant) ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Google Drive (optional) ---
# On the cloud, paste the WHOLE service-account JSON as one line here:
GOOGLE_CREDENTIALS_JSON=
# Locally you may instead point to the JSON file:
# GOOGLE_APPLICATION_CREDENTIALS=service-account.json
# A Drive folder shared with the service account (file uploads need a Shared Drive):
GOOGLE_DRIVE_FOLDER_ID=
